<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AgendaEscolar.Vistas.DetalleActividadPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Detalle de actividad"
    BackgroundColor="#F4F6FA">

    <ScrollView>
        <VerticalStackLayout Padding="22" Spacing="12">

            <Label
                Text="Detalles de la actividad"
                FontSize="26"
                FontAttributes="Bold"
                TextColor="#263238" />

            <Label
                Text="Puedes consultar y modificar la información."
                FontSize="14"
                TextColor="#607D8B" />

            <Label
                Text="Nombre de la actividad"
                TextColor="#2563EB"
                FontAttributes="Bold" />

            <Entry
                x:Name="EntradaNombre"
                Placeholder="Nombre de la actividad"
                TextColor="#000000"
                PlaceholderColor="#777777"
                BackgroundColor="White" />

            <Label
                Text="Materia"
                TextColor="#2563EB"
                FontAttributes="Bold" />

            <Entry
                x:Name="EntradaMateria"
                Placeholder="Materia"
                TextColor="#000000"
                PlaceholderColor="#777777"
                BackgroundColor="White" />

            <Label
                Text="Fecha de asignación"
                TextColor="#2563EB"
                FontAttributes="Bold" />

            <DatePicker
                x:Name="SelectorFechaAsignacion"
                Format="dd/MM/yyyy"
                TextColor="#000000"
                BackgroundColor="White" />

            <Label
                Text="Fecha de entrega"
                TextColor="#2563EB"
                FontAttributes="Bold" />

            <DatePicker
                x:Name="SelectorFechaEntrega"
                Format="dd/MM/yyyy"
                TextColor="#000000"
                BackgroundColor="White" />

            <Label
                Text="Descripción"
                TextColor="#2563EB"
                FontAttributes="Bold" />

            <Editor
                x:Name="EntradaDescripcion"
                Placeholder="Descripción de la actividad"
                TextColor="#000000"
                PlaceholderColor="#777777"
                HeightRequest="120"
                BackgroundColor="White" />

            <HorizontalStackLayout
                Spacing="10"
                VerticalOptions="Center">

                <CheckBox
                    x:Name="CasillaCompletada"
                    Color="#2563EB" />

                <Label
                    Text="Actividad completada"
                    TextColor="#2563EB"
                    FontAttributes="Bold"
                    VerticalOptions="Center" />

            </HorizontalStackLayout>

            <Button
                Text="Guardar cambios"
                Clicked="OnGuardarCambiosClicked"
                BackgroundColor="#356AE6"
                TextColor="White"
                CornerRadius="12"
                HeightRequest="50" />

            <Button
                Text="Eliminar actividad"
                Clicked="OnEliminarClicked"
                BackgroundColor="#D94343"
                TextColor="White"
                CornerRadius="12"
                HeightRequest="50" />

            <Button
                Text="Regresar"
                Clicked="OnRegresarClicked"
                BackgroundColor="#E0E5EC"
                TextColor="#263238"
                CornerRadius="12"
                HeightRequest="45" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>