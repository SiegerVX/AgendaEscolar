<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AgendaEscolar.Vistas.InicioPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Inicio"
    BackgroundColor="#F4F6FA">

    <VerticalStackLayout Padding="20" Spacing="15">

        <Label
            Text="Mi agenda escolar"
            FontSize="28"
            FontAttributes="Bold"
            TextColor="#263238" />

        <Label
            Text="Organiza tus actividades y fechas de entrega."
            FontSize="14"
            TextColor="#607D8B" />

        <Label
            Text="Actividades pendientes"
            FontSize="20"
            FontAttributes="Bold"
            TextColor="#263238"
            Margin="0,10,0,0" />

        <CollectionView
    x:Name="ListaActividades"
    EmptyView="No hay actividades pendientes."
    SelectionMode="Single"
    SelectionChanged="OnActividadSeleccionada">

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border
                        BackgroundColor="White"
                        Stroke="#E0E5EC"
                        StrokeThickness="1"
                        Padding="15"
                        Margin="0,5"
                        StrokeShape="RoundRectangle 12">

                        <VerticalStackLayout Spacing="7">

                            <Label
                                Text="{Binding Nombre}"
                                FontSize="18"
                                FontAttributes="Bold"
                                TextColor="#263238" />

                            <Label
                                Text="{Binding Materia, StringFormat='Materia: {0}'}"
                                FontSize="14"
                                TextColor="#546E7A" />

                            <Label
                                Text="{Binding FechaEntrega, StringFormat='Fecha de entrega: {0:dd/MM/yyyy}'}"
                                FontSize="14"
                                TextColor="#356AE6" />

                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>


        <Button
    Text="+ Nueva actividad"
    Clicked="OnNuevaActividadClicked"
    BackgroundColor="#356AE6"
    TextColor="White"
    CornerRadius="12"
    HeightRequest="50" />


    </VerticalStackLayout>

</ContentPage>